{
  "name": "@issueit/mcp",
  "version": "0.1.0",
  "description": "Issueit MCP server: read bug reports with the diagnostics captured when they were sent, fix them, and mark them done.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "issueit",
    "bug-reports"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "issueit-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/stdio.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js && chmod +x dist/index.js",
    "dev": "tsx src/stdio.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
