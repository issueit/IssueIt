# Public address people use to reach Issueit. Links in emails, issues and the widget snippet use it.
APP_URL=http://192.168.0.62:8380
# Optional split hosting: set these when the dashboard, ingestion API and widget live on different hosts.
# DROP_URL=https://drop.issueit.app
# CDN_URL=https://cdn.issueit.app
# DOCS_URL=https://docs.issueit.app

# Generate each with: openssl rand -base64 32
ENCRYPTION_KEY=
SECRET_KEY=
POSTGRES_PASSWORD=

# Host port and interface for docker compose.
# With a Cloudflare tunnel, set ISSUEIT_BIND=127.0.0.1 so the port isn't reachable from the network.
ISSUEIT_PORT=8380
ISSUEIT_BIND=0.0.0.0

# Cloudflare tunnel, for public HTTPS without opening a port. From the
# Zero Trust dashboard: Networks, Tunnels, your tunnel, the connector token.
# Only used by: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

ALLOW_SIGNUP=true
# Behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Allow webhooks to private network addresses (only for trusted, self-hosted setups).
WEBHOOK_ALLOW_PRIVATE=false

# Mail server for emails Issueit sends itself, such as receipts and "it's fixed" notes to reporters.
# smtps://user:password@smtp.example.com:465 or smtp://user:password@smtp.example.com:587
# Without it, projects can still email reporters through their own connected email service.
SMTP_URL=
SMTP_FROM=Issueit <no-reply@example.com>

# How often, in minutes, to check whether tracker issues were closed. 0 turns it off.
SYNC_INTERVAL_MINUTES=5

# Limits
MAX_ATTACHMENT_MB=10
MAX_ATTACHMENTS_PER_REPORT=5
RATE_LIMIT_IP_PER_MINUTE=10
RATE_LIMIT_PROJECT_PER_HOUR=1000
RATE_LIMIT_KEY_PER_MINUTE=120
# 0 means unlimited.
PLAN_REPORTS_PER_MONTH=0
PLAN_STORAGE_MB=0

# OAuth apps (optional). Redirect URL for each: ${APP_URL}/api/oauth/<service>/callback
# Without them, each integration offers a token-based connection instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
TRELLO_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_URL=https://gitlab.com
