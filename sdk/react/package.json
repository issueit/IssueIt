{
  "name": "@issueit/react",
  "version": "0.1.0",
  "description": "Issueit for React: an error boundary that files the bug, and a hook to open the report form.",
  "keywords": [
    "issueit",
    "bug-reports",
    "react",
    "error-boundary"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "~5.9"
  }
}
